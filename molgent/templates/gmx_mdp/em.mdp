; Energy minimization for ClC-2 / AK-42 (CHARMM36m + CGenFF, paper protocol).
; Steepest descent until Fmax < 1000 kJ/(mol nm) or 5000 steps.
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 5000

; Neighbor searching - CHARMM36m standard.
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
rlist                   = 1.2
pbc                     = xyz

; Electrostatics + vdW (CHARMM36m: PME + force-switched LJ).
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no
