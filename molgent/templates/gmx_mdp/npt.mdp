; NPT equilibration, paper protocol (Ma et al. 2023, Parrinello-Rahman, 1 ns).
; Position restraints on protein heavy atoms still active.
define                  = -DPOSRES

integrator              = md
dt                      = {timestep_ps}
nsteps                  = {nsteps}

; Output control.
nstxout                 = 0
nstvout                 = 0
nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 5000
compressed-x-grps       = System

; Bond constraints.
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-iter              = 1
lincs-order             = 4

; Neighbor searching.
cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 20
rlist                   = 1.2
pbc                     = xyz

; Electrostatics + vdW.
coulombtype             = PME
rcoulomb                = 1.2
fourierspacing          = 0.16
pme_order               = 4
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no

; Temperature coupling — V-rescale.
; tc-grps follows CHARMM-GUI Membrane Builder convention.
tcoupl                  = v-rescale
tc-grps                 = SOLU MEMB SOLV
tau_t                   = 0.1   0.1   0.1
ref_t                   = {temperature_k}  {temperature_k}  {temperature_k}

; Pressure coupling — Parrinello-Rahman, semi-isotropic (membrane).
pcoupl                  = Parrinello-Rahman
pcoupltype              = semiisotropic
tau_p                   = 5.0
ref_p                   = {pressure_bar} {pressure_bar}
compressibility         = 4.5e-5 4.5e-5
refcoord_scaling        = com

; Carry velocities from NVT.
gen_vel                 = no
continuation            = yes
